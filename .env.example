# Sanity CMS (optionnel — sans ces variables, le site utilise src/data/ en fallback)
VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production

# Token Viewer (lecture seule) — UNIQUEMENT pour l’aperçu Presentation dans le Studio.
# Ne jamais utiliser un token avec droits d’écriture. Les visiteurs n’activent pas ce mode.
# Créer dans manage.sanity.io → API → Tokens → Viewer
# CORS Sanity : autoriser http://localhost:5173 et https://hugues-absil.github.io
VITE_SANITY_VIEWER_TOKEN=

# GitHub Pages : base path /site/ (défini automatiquement par le workflow CI)
# GITHUB_PAGES=true

# Surcharge du chemin de base (ex. /site/ pour hugues-absil.github.io/site/)
# VITE_BASE_PATH=/site/
